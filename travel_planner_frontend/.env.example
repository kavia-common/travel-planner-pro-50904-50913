# Development environment variables for the Travel Planner frontend (React)

# API base URL used by the frontend client. If not set, defaults to http://localhost:3001
REACT_APP_API_BASE_URL=http://localhost:3001

# Allow non-local preview hosts for the CRA dev server.
# Use ONLY in development/preview environments to bypass host checking and avoid "Invalid Host header".
# Do NOT use in production.
DANGEROUSLY_DISABLE_HOST_CHECK=true
